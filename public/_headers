# Content-Security-Policy served as an HTTP header
# Supported by: Netlify, Cloudflare Pages, Vercel (via vercel.json)
# This closes the gap between page load and the JS-injected meta tag.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://localhost:* http://127.0.0.1:* https://huggingface.co https://cdn-lfs.huggingface.co https://api.allorigins.win https://api.duckduckgo.com; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'